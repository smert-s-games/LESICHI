-+    else split_part(split_part(lower(trim(p)), '@', 1), '+', 1) || '@' || split_part(lower(trim(p)), '@', 2)
-+  end;
-+$$;
-+
-+create or replace function public.recalc_session_status(p_session_id uuid)
-+returns void
-+language sql
-+security definer
-+set search_path = public
